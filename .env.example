# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres — use the pooled connection string from the Neon console (Connect → Pooled connection).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Better Auth — secret: at least 32 random characters (openssl rand -base64 32).
BETTER_AUTH_SECRET=""
# The app's public URL. http://localhost:3000 in development; your Vercel URL in production.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary — hosts voiceovers, sounds and music (Dashboard → API Keys). Server-side only.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
